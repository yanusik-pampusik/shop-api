# Export these values in your shell; the service does not load .env automatically.
AUTH_DB_DSN='host=localhost user=postgres password=postgres dbname=shopapi_auth port=5432 sslmode=disable'
AUTH_GRPC_ADDR=127.0.0.1:50051
# Generate your own value: openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=authservice
AUTH_JWT_AUDIENCE=shopapi
AUTH_TOKEN_TTL=1h
